{
  "name": "viajes-mundo",
  "version": "1.0.0",
  "description": "Un sitio web sobre viajes por el mundo - Práctica de desarrollo frontend moderno",
  "scripts": {
    "dev": "parcel src/index.html src/categoria.html src/det1.html src/det2.html src/links.html",
    "build": "parcel build src/index.html src/categoria.html src/det1.html src/det2.html src/links.html --public-url ./",
    "clean": "rimraf dist .parcel-cache",
    "preview": "serve dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/usuario/viajes-mundo.git"
  },
  "keywords": [
    "travel",
    "viajes",
    "frontend",
    "html",
    "css",
    "javascript",
    "responsive"
  ],
  "author": "Usuario",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.6",
    "@babel/preset-env": "^7.23.6",
    "@parcel/packager-raw-url": "^2.16.3",
    "@parcel/transformer-jsonld": "^2.16.3",
    "autoprefixer": "^10.4.16",
    "parcel": "^2.11.0",
    "postcss": "^8.4.32",
    "postcss-nested": "^6.0.1",
    "rimraf": "^5.0.5",
    "serve": "^14.2.1"
  },
  "dependencies": {
    "aos": "^2.3.4",
    "swiper": "^11.0.5"
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "not op_mini all"
  ]
}
